# ==========================================
# LEADGEN LITE CONFIGURATION (.env)
# ==========================================

# Application
APP_NAME="LeadGen Lite"
SECRET_KEY="replace-with-a-secure-random-32-character-secret-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Local development default: SQLite
DATABASE_URL="sqlite:///./leadgen_lite.db"
# Render PostgreSQL (Render provides postgres://, automatically normalized to postgresql://):
# DATABASE_URL="postgresql://leadgen_user:password@hostname:5432/leadgen_lite"

# ==========================================
# OPTIONAL INTEGRATION CREDENTIALS (₹0 Default)
# None of these are required to run core pipelines
# ==========================================

# 1. Google Places API (Optional - Pipeline A)
# Used for live Google Maps local business searches
GOOGLE_PLACES_API_KEY=""

# 2. Commercial Search API (Optional - Pipeline A)
# SerpApi or ValueSERP API key for structured search listings
SEARCH_API_KEY=""

# 3. Google PageSpeed Insights API (Optional - Website Audits)
PAGESPEED_API_KEY=""

# 4. Optional AI LLM Integration (Outreach Generator)
# If omitted, LeadGen Lite uses its high-converting template engine in EN and HI for free!
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# 5. SMTP Email Outreach (Optional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""

# 6. WhatsApp Business Cloud API (Optional)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
